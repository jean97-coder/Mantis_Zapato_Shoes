# Copia este archivo a ".env" en la raiz del proyecto (junto a docker-compose.yml)
# y reemplaza los valores antes de desplegar en el VPS.
# NUNCA subas el archivo ".env" real a GitHub (ya esta en .gitignore).

# --- PostgreSQL ---
POSTGRES_DB=Mantis_zapatos_db
POSTGRES_USER=jcshoes
POSTGRES_PASSWORD=cambia_esta_contrasena_segura

# --- Backend / API ---
# Genera uno nuevo con: openssl rand -base64 48
JWT_SECRET=cambia_este_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=7d

# Origen publico del frontend, usado por el backend para validar CORS.
CLIENT_ORIGIN=https://jcshoesglobal.com

# --- Proxy / HTTPS (Caddy) ---
# Dominios que debe atender el certificado (separados por coma+espacio).
# Cloudflare DNS debe apuntar ambos a la IP del VPS antes de levantar esto.
DOMAIN=jcshoesglobal.com, www.jcshoesglobal.com
# Correo para el registro ante Let's Encrypt (avisos de expiracion, etc).
ACME_EMAIL=tu-correo@jcshoesglobal.com

# --- Telegram (opcional, dejar vacio si no se usa) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALERT_HOURS=
